NEXT_PUBLIC_OUTPOST_APP_URL=http://localhost:3000

# Vercel Preview proof. Leave NEXT_PUBLIC_OUTPOST_APP_URL unset in Vercel so
# the deployed app can derive https://${VERCEL_URL}; set it locally only when
# proving a specific deployment URL from this machine.
OUTPOST_VERCEL_DEPLOYMENT_URL=https://<deployment>.vercel.app
VERCEL_AUTOMATION_BYPASS_SECRET=<optional-protected-preview-bypass-secret>

# Neon Auth and Data API endpoints for the active Outpost backend path.
NEXT_PUBLIC_NEON_AUTH_URL=https://<auth-host>/<database>/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://<api-host>/<database>/rest/v1

# Neon project and branch metadata for verification scripts.
OUTPOST_NEON_PROJECT_ID=replace-with-outpost-neon-project-id
OUTPOST_NEON_BRANCH_NAME=replace-with-neon-branch-name
OUTPOST_NEON_DATABASE_NAME=neondb
OUTPOST_NEON_ROLE_NAME=neondb_owner

# Local/spike proof may use the seeded local password. Hosted proof must use a
# rotated hosted seed password and must not point at the spike branch.
OUTPOST_NEON_SEED_PASSWORD=outpost-local-password

# Optional direct database URL for one-off migration tooling or psql inspection.
# Prefer the Neon CLI for scripted proof so credentials are not persisted here.
OUTPOST_NEON_DATABASE_URL=postgresql://<role>:<password>@<direct-host>/<database>?sslmode=require&channel_binding=require

# Atlas migration/operator credential. Keep this owner-capable URL out of the
# deployed worker runtime; migration commands use it only for explicit applies.
OUTPOST_DATABASE_URL=postgresql://<migration-owner>:<password>@<direct-host>/<database>?sslmode=require&channel_binding=require

# Runtime worker login. This must be a non-owner LOGIN granted only the
# outpost_job_runtime capability role. Never reuse the migration-owner URL.
OUTPOST_RUNTIME_DATABASE_URL=postgresql://<runtime-role>:<password>@<host>/<database>?sslmode=require&channel_binding=require

# Policy compiler login. This must be a non-owner LOGIN and the sole holder of
# outpost_policy_compiler without ADMIN OPTION. It must target the same Neon
# endpoint as NEXT_PUBLIC_NEON_DATA_API_URL. Never reuse owner or worker URLs.
OUTPOST_POLICY_DATABASE_URL=postgresql://<policy-role>:<password>@<host>/<database>?sslmode=require&channel_binding=require

# Provider ingress login. This must be a non-owner LOGIN granted only the
# outpost_provider_ingress capability role. Never reuse owner or worker URLs.
OUTPOST_INGRESS_DATABASE_URL=postgresql://<ingress-role>:<password>@<host>/<database>?sslmode=require&channel_binding=require

# Public provider routes stay absent unless an operator sets this exact
# rehearsal-only value on a protected deployment. No live value is supported.
OUTPOST_PROVIDER_INGRESS_ROUTE_MODE=blocked

# Dedicated protected-Preview rehearsal authorization. Do not reuse the Vercel
# automation bypass, provider signing secret, or any production credential.
OUTPOST_PROVIDER_INGRESS_REHEARSAL_TOKEN=<random-32-byte-minimum-token>
